{
  "name": "@ios-sim/host",
  "version": "0.1.0",
  "private": true,
  "description": "macOS host daemon that exposes CoreSimulator over HTTP and WebSocket.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ios-sim-host": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "dev": "tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@ios-sim/protocol": "0.1.0",
    "fastify": "^5.6.1",
    "tar": "^7.5.1",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  }
}
