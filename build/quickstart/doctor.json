{
  "schemaVersion": 1,
  "service": "ios-sim-native",
  "version": "0.1.0",
  "runtime": "bun",
  "runtimeVersion": "1.4.4",
  "platform": "darwin",
  "architecture": "arm64",
  "simulator": false,
  "features": [
    {
      "id": "macho.parse",
      "state": "yes",
      "detail": "thin/fat arm64, load commands, symbols, export tries"
    },
    {
      "id": "macho.chained",
      "state": "yes",
      "detail": "PTR_64, PTR_64_OFFSET, arm64e formats"
    },
    {
      "id": "dyld.legacy",
      "state": "yes",
      "detail": "LC_DYLD_INFO rebase/bind opcodes"
    },
    {
      "id": "dyld.lazy",
      "state": "partial",
      "detail": "sites recorded; caller binds on first use"
    },
    {
      "id": "dyld.weak",
      "state": "partial",
      "detail": "flat lookup; missing becomes null"
    },
    {
      "id": "dyld.initTerm",
      "state": "yes",
      "detail": "__mod_init_func/__mod_term_func, LC_ROUTINES_64"
    },
    {
      "id": "dyld.dlopenApi",
      "state": "yes",
      "detail": "refcounted open/symbol/close handles"
    },
    {
      "id": "dyld.dlopenSyscalls",
      "state": "no",
      "detail": "guest dlopen traps are not wired"
    },
    {
      "id": "dyld.signatureParse",
      "state": "yes",
      "detail": "superblob, CodeDirectory, entitlements"
    },
    {
      "id": "dyld.signatureVerify",
      "state": "no",
      "detail": "hashes, certificates, CMS unverified"
    },
    {
      "id": "dyld.sharedCache",
      "state": "no",
      "detail": "licensed cache parsing is Mac-gated"
    },
    {
      "id": "threads.scheduler",
      "state": "yes",
      "detail": "round-robin guest scheduler with block/wake"
    },
    {
      "id": "threads.timers",
      "state": "yes",
      "detail": "timer/source event loop, no busy wait"
    },
    {
      "id": "threads.processTable",
      "state": "yes",
      "detail": "fork/exec/waitpid/groups, 64-process stress"
    },
    {
      "id": "threads.signals",
      "state": "yes",
      "detail": "handler/mask/raise/kill, SIGCHLD"
    },
    {
      "id": "kernel.c11ffi",
      "state": "yes",
      "detail": "C11 host via Bun FFI, quotas and stress"
    },
    {
      "id": "xpc.codec",
      "state": "yes",
      "detail": "typed XPC-style codec and Mach connection"
    },
    {
      "id": "observability.events",
      "state": "yes",
      "detail": "schema v1 JSON/NDJSON with redaction"
    },
    {
      "id": "observability.trace",
      "state": "yes",
      "detail": "Chrome Trace Event export"
    },
    {
      "id": "quality.fuzz",
      "state": "yes",
      "detail": "1M outcome-guided mutations per parser"
    },
    {
      "id": "quality.corpus",
      "state": "yes",
      "detail": "23 generated Mach-O cases"
    },
    {
      "id": "quality.bench",
      "state": "yes",
      "detail": "machine metadata + seven budgeted cases"
    },
    {
      "id": "quality.soak",
      "state": "yes",
      "detail": "Mach/loader/process counters, leak gate"
    },
    {
      "id": "uikit.nativeX11",
      "state": "partial",
      "detail": "clean-room UIKit-compatible blank window"
    },
    {
      "id": "apple.uikit",
      "state": "no",
      "detail": "Apple UIKit is not runnable without licensed frameworks"
    },
    {
      "id": "apple.simulator",
      "state": "no",
      "detail": "no CoreSimulator/launchd_sim/SpringBoard boot"
    }
  ],
  "blocked": [
    {
      "id": "dyld.sharedCache",
      "state": "no",
      "detail": "needs a licensed Mac and shared-cache reader"
    },
    {
      "id": "dyld.signatureVerify",
      "state": "no",
      "detail": "security work plus trusted anchor policy"
    },
    {
      "id": "dyld.dlopenSyscalls",
      "state": "no",
      "detail": "guest syscall wiring is future work"
    },
    {
      "id": "apple.uikit",
      "state": "no",
      "detail": "licensed Apple runtime and multi-year platform work"
    },
    {
      "id": "apple.simulator",
      "state": "no",
      "detail": "CoreSimulator, launchd_sim, SpringBoard, APFS images"
    },
    {
      "id": "graphics.metal",
      "state": "no",
      "detail": "Metal/IOSurface/CoreAnimation are not implemented"
    },
    {
      "id": "runtime.foundation",
      "state": "no",
      "detail": "Objective-C/Swift runtimes are not implemented"
    }
  ],
  "notes": [
    "This is a research substrate, not a simulator.",
    "Clean-room UIKitLite in native X11 is not Apple UIKit.",
    "The CLI never loads Apple binaries; use your own arm64 Mach-O or the demo."
  ]
}
