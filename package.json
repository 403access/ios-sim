{
  "name": "ios-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Control an iOS Simulator running on a Mac from any Linux machine.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs-site"
  ],
  "scripts": {
    "build": "bun run --cwd packages/protocol build && bun run --cwd packages/darwin-compat build && bun run --cwd packages/darwin-host build && bun run --cwd apps/host build && bun run --cwd apps/cli build && bun run --cwd apps/native build",
    "native": "bun apps/native/dist/bin.js",
    "test:native": "vitest run packages/darwin-compat apps/native",
    "build:uikit": "./scripts/build-uikit-native.sh",
    "test:uikit": "./scripts/test-uikit-linux.sh",
    "build:kernel": "./scripts/build-darwin-host.sh",
    "test:kernel": "./scripts/test-darwin-host.sh",
    "test:kernel:linux": "./scripts/test-kernel-linux.sh",
    "dev:host": "bun run --cwd apps/host dev",
    "dev:docs": "bun run --cwd docs-site start",
    "docs:build": "bun run --cwd docs-site build",
    "docs:check": "bun scripts/check-docs-links.ts",
    "ios-sim": "bun apps/cli/dist/bin.js",
    "ios-sim-host": "bun apps/host/dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:macos": "IOS_SIM_MACOS_TESTS=1 vitest run tests/macos",
    "test:linux": "./scripts/test-linux.sh",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary",
    "coverage": "bun run test:coverage && bun scripts/check-coverage.ts",
    "fuzz": "bun scripts/fuzz-darwin.ts",
    "fuzz:1m": "bun scripts/fuzz-darwin.ts --iterations 1000000",
    "corpus": "bun scripts/build-corpus.ts",
    "bench": "bun scripts/bench.ts",
    "soak": "bun scripts/soak.ts",
    "provenance": "bun scripts/check-provenance.ts",
    "claims": "bun scripts/check-claims.ts",
    "roadmap:check": "bun scripts/check-roadmap.ts",
    "versions": "bun scripts/check-versions.ts",
    "supply-chain": "bun scripts/check-supply-chain.ts",
    "repro:bundle": "bun scripts/repro-bundle.ts",
    "quickstart": "./scripts/quickstart.sh",
    "repro": "bun scripts/repro-fixtures.ts",
    "package:native": "bun scripts/package-native.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run docs:build",
    "verify": "./scripts/verify.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "5.0.5",
    "tar": "^7.5.22",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "ws": "^8.18.3"
  },
  "overrides": {
    "serialize-javascript": "^7.1.3",
    "tinypool": "^2.1.1",
    "uuid": "^11.1.1"
  }
}
